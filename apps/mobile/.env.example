# Copy to .env.local and fill in with the same Supabase project apps/web
# uses (Project Settings > API). VITE_ vars are inlined into the built app
# at build time (Vite's equivalent of Next.js's NEXT_PUBLIC_ or Expo's
# EXPO_PUBLIC_ prefix) — never put a secret key here.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe to expose in the built app; replaces the legacy "anon" key).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: a Sentry project DSN (sentry.io > Settings > Projects > (project)
# > Client Keys). Public identifier, not a secret. Without it, crash
# reporting stays disabled.
VITE_SENTRY_DSN=
