# Copy to .env.local and fill in with the same Supabase project apps/web
# uses (Project Settings > API). EXPO_PUBLIC_ vars are inlined into the
# built app, same as NEXT_PUBLIC_ ones in apps/web — never put a secret
# key here.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (safe to expose in the built app; replaces the legacy "anon" key).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
