# Copy to .env.local and fill in with values from your own Supabase project
# (Project Settings > API). Never commit .env.local — it's gitignored.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (safe to expose to the browser; replaces the legacy "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-only; NEVER prefix with NEXT_PUBLIC_ or expose to the
# browser). Only needed for privileged server-side/admin operations that
# must bypass RLS — most of the app should never need this.
# SUPABASE_SECRET_KEY=

# Mapbox public access token (Account > Tokens at mapbox.com), used to render
# the real interactive route map on a trip's detail page. Mapbox's public
# tokens are designed to ship to the browser like this — for production, scope
# it to your app's domain(s) under the token's URL restrictions. Without this
# set, trip routes fall back to a dependency-free SVG shape plot with no
# street-map tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
